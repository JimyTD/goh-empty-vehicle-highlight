{game_entity
	;// empty_vehicle_highlight proxy for humber_scout (generated)
	{Extension "humber_scout.mdl"}
	{extender "stuff"
		{item "evh_humber_scout"}
	}
	{props "steel" "nocover"}
	{obstacleID "stuff"}
	{volume "armor1" {able clear}}
	{volume "armor2" {able clear}}
	{volume "body1" {able clear}}
	{volume "body2" {able clear}}
	{volume "body3" {able clear}}
	{volume "engine1" {able clear}}
	{volume "fuel1" {able clear}}
	{volume "ram" {able clear}}
	{volume "transmission" {able clear}}
	{volume "wheelleft1" {able clear}}
	{volume "wheelleft2" {able clear}}
	{volume "wheelright1" {able clear}}
	{volume "wheelright2" {able clear}}
	{lodclass "vehicle"}
	{NoGroupMesh 1}
	{NoVisibilityPatch}
	{NoCastShadows}
}
