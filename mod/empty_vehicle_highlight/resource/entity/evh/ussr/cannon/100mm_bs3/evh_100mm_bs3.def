{game_entity
	;// empty_vehicle_highlight proxy for 100mm_bs3 (generated)
	{Extension "100mm_bs3.mdl"}
	{extender "stuff"
		{item "evh_100mm_bs3"}
	}
	{props "steel" "nocover"}
	{obstacleID "stuff"}
	{volume "barrel1" {able clear}}
	{volume "barrel2" {able clear}}
	{volume "barrel3" {able clear}}
	{volume "body1" {able clear}}
	{volume "body2" {able clear}}
	{volume "select" {able clear}}
	{volume "shield" {able clear}}
	{volume "shield_lower" {able clear}}
	{volume "standl" {able clear}}
	{volume "standr" {able clear}}
	{volume "wheelleft" {able clear}}
	{volume "wheelright" {able clear}}
	{lodclass "vehicle"}
	{NoGroupMesh 1}
	{NoVisibilityPatch}
	{NoCastShadows}
}
