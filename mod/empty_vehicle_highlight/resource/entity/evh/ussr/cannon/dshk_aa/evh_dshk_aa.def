{game_entity
	;// empty_vehicle_highlight proxy for dshk_aa (generated)
	{Extension "dshk_aa.mdl"}
	{extender "stuff"
		{item "evh_dshk_aa"}
	}
	{props "steel" "nocover"}
	{obstacleID "stuff"}
	{volume "body1" {able clear}}
	{volume "body2" {able clear}}
	{volume "body3" {able clear}}
	{volume "body4" {able clear}}
	{volume "body5" {able clear}}
	{volume "body6" {able clear}}
	{volume "magazine" {able clear}}
	{volume "select" {able clear}}
	{volume "wheelleft" {able clear}}
	{volume "wheelright" {able clear}}
	{lodclass "vehicle"}
	{NoGroupMesh 1}
	{NoVisibilityPatch}
	{NoCastShadows}
}
