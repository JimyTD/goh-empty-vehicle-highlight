{game_entity
	;// empty_vehicle_highlight proxy for universal (generated)
	{Extension "../../../../-vehicle/generic/car/universal/universal.mdl"}
	{extender "stuff"
		{item "evh_universal"}
	}
	{props "steel" "nocover"}
	{obstacleID "stuff"}
	{volume "body1" {able clear}}
	{volume "body2" {able clear}}
	{volume "body3" {able clear}}
	{volume "engine1" {able clear}}
	{volume "engine2" {able clear}}
	{volume "fuel" {able clear}}
	{volume "transmission" {able clear}}
	{volume "wheelleft1" {able clear}}
	{volume "wheelleft2" {able clear}}
	{volume "wheelright1" {able clear}}
	{volume "wheelright2" {able clear}}
	{lodclass "vehicle"}
	{NoGroupMesh 1}
	{NoVisibilityPatch}
	{NoCastShadows}
}
