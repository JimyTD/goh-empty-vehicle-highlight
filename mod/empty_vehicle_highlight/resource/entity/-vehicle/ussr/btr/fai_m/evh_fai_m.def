	;// empty_vehicle_highlight proxy for fai_m (generated)
	{Extension "fai_m.mdl"}
	{extender "stuff"
		{item "evh_fai_m"}
	}
	{props "steel" "nocover"}
	{obstacleID "stuff"}
	{volume "body1" {able clear}}
	{volume "body2" {able clear}}
	{volume "body3" {able clear}}
	{volume "cupola" {able clear}}
	{volume "cupola2" {able clear}}
	{volume "cupola3" {able clear}}
	{volume "detail1" {able clear}}
	{volume "engine" {able clear}}
	{volume "fuel" {able clear}}
	{volume "ram" {able clear}}
	{volume "transmission" {able clear}}
	{volume "turret" {able clear}}
	{volume "wheelleft1" {able clear}}
	{volume "wheelleft2" {able clear}}
	{volume "wheelright1" {able clear}}
	{volume "wheelright2" {able clear}}
	{lodclass "vehicle"}
	{NoGroupMesh 1}
	{NoVisibilityPatch}
	{NoCastShadows}
}
