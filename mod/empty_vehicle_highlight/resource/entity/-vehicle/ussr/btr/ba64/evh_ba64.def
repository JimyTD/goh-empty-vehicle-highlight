{game_entity
	;// empty_vehicle_highlight proxy for ba64 (generated)
	{Extension "ba64.mdl"}
	{extender "stuff"
		{item "evh_ba64"}
	}
	{props "steel" "nocover"}
	{obstacleID "stuff"}
	{volume "body" {able clear}}
	{volume "engine" {able clear}}
	{volume "fuel" {able clear}}
	{volume "hoie2" {able clear}}
	{volume "hole1" {able clear}}
	{volume "ram" {able clear}}
	{volume "shield" {able clear}}
	{volume "transmission" {able clear}}
	{volume "turret" {able clear}}
	{volume "wheelleft1" {able clear}}
	{volume "wheelleft2" {able clear}}
	{volume "wheelright1" {able clear}}
	{volume "wheelright2" {able clear}}
	{lodclass "vehicle"}
	{NoGroupMesh 1}
	{NoVisibilityPatch}
	{NoCastShadows}
}
