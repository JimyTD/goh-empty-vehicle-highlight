{game_entity
	;// empty_vehicle_highlight proxy for ford_gpa (generated)
	{Extension "ford_gpa.mdl"}
	{extender "stuff"
		{item "evh_ford_gpa"}
	}
	{props "steel" "nocover"}
	{obstacleID "stuff"}
	{volume "body1" {able clear}}
	{volume "body2" {able clear}}
	{volume "body3" {able clear}}
	{volume "detail1" {able clear}}
	{volume "engine1" {able clear}}
	{volume "fuel" {able clear}}
	{volume "hole1" {able clear}}
	{volume "hole2" {able clear}}
	{volume "hole3" {able clear}}
	{volume "hole4" {able clear}}
	{volume "hole5" {able clear}}
	{volume "hole6" {able clear}}
	{volume "hole7" {able clear}}
	{volume "ram" {able clear}}
	{volume "wheelleft1" {able clear}}
	{volume "wheelleft2" {able clear}}
	{volume "wheelright1" {able clear}}
	{volume "wheelright2" {able clear}}
	{volume "window1" {able clear}}
	{volume "window2" {able clear}}
	{lodclass "vehicle"}
	{NoGroupMesh 1}
	{NoVisibilityPatch}
	{NoCastShadows}
}
