{game_entity
	;// empty_vehicle_highlight proxy for kfz15 (generated)
	{Extension "kfz15.mdl"}
	{extender "stuff"
		{item "evh_kfz15"}
	}
	{props "steel" "nocover"}
	{obstacleID "stuff"}
	{volume "armor" {able clear}}
	{volume "body1" {able clear}}
	{volume "body2" {able clear}}
	{volume "engine" {able clear}}
	{volume "fuel" {able clear}}
	{volume "hole1" {able clear}}
	{volume "ram" {able clear}}
	{volume "transmission" {able clear}}
	{volume "wheelleft1" {able clear}}
	{volume "wheelleft2" {able clear}}
	{volume "wheelright1" {able clear}}
	{volume "wheelright2" {able clear}}
	{volume "wheelspare1" {able clear}}
	{volume "wheelspare2" {able clear}}
	{volume "window1" {able clear}}
	{volume "window2" {able clear}}
	{lodclass "vehicle"}
	{NoGroupMesh 1}
	{NoVisibilityPatch}
	{NoCastShadows}
}
