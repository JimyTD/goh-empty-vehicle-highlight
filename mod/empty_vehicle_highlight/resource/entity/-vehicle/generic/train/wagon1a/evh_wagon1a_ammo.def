{game_entity
	;// empty_vehicle_highlight proxy for wagon1a_ammo (generated)
	{Extension "wagon1a_ammo.mdl"}
	{extender "stuff"
		{item "evh_wagon1a_ammo"}
	}
	{props "steel" "nocover"}
	{obstacleID "stuff"}
	{volume "body1" {able clear}}
	{volume "body2" {able clear}}
	{volume "body3" {able clear}}
	{volume "body4" {able clear}}
	{volume "wheelleft1" {able clear}}
	{volume "wheelleft2" {able clear}}
	{volume "wheelright1" {able clear}}
	{volume "wheelright2" {able clear}}
	{lodclass "vehicle"}
	{NoGroupMesh 1}
	{NoVisibilityPatch}
	{NoCastShadows}
}
