{game_entity
	;// empty_vehicle_highlight proxy for small_barge (generated)
	{Extension "small_barge.mdl"}
	{extender "stuff"
		{item "evh_small_barge"}
	}
	{props "steel" "nocover"}
	{obstacleID "stuff"}
	{volume "body1" {able clear}}
	{volume "body2" {able clear}}
	{volume "body3" {able clear}}
	{volume "body4" {able clear}}
	{volume "body5" {able clear}}
	{volume "body6" {able clear}}
	{volume "body7" {able clear}}
	{volume "body8" {able clear}}
	{volume "body9" {able clear}}
	{volume "cabin" {able clear}}
	{lodclass "vehicle"}
	{NoGroupMesh 1}
	{NoVisibilityPatch}
	{NoCastShadows}
}
